# ========================================================
# MONEY EFT PRACTITIONER — WORKSHOP CONFIGURATION (EXAMPLE)
# ========================================================
# Copy this file to .env locally, or add these variables in:
# Vercel Dashboard -> Project Settings -> Environment Variables
# ========================================================

# Workshop Date Range (e.g. "17–18th October", "24–25th October", "7–8th November")
EVENT_DATE="17–18th October"

# Workshop Time (e.g. "12–3 PM", "12–3 PM IST", "10 AM – 1 PM IST")
EVENT_TIME="12–3 PM"

# Workshop Special Price in INR (e.g. "199", "299", "₹199")
EVENT_PRICE="199"

# Workshop Regular / Strike-through Price in INR (e.g. "999", "1499", "₹999")
EVENT_ORIGINAL_PRICE="999"

# Optional Custom Overrides (auto-computed from EVENT_DATE if omitted)
# EVENT_DAY1="17 October (Sat)"
# EVENT_DAY2="18 October (Sun)"

# Optional Custom Payment/Checkout Link
# EVENT_PAYMENT_URL="https://live.sonalwadhwa.com/payment-secure-page"
